{
  "name": "gru953-studio",
  "displayName": "Universal Agentic Studio",
  "description": "GRU953-Studio - Universal Agentic Studio for VS Code, Cursor, and Windsurf",
  "version": "4.5.0",
  "publisher": "GRU-953",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gru953-studio.start",
        "title": "Universal Agentic Studio: Start"
      },
      {
        "command": "gru953-studio.status",
        "title": "Universal Agentic Studio: Status"
      },
      {
        "command": "gru953-studio.pause",
        "title": "Universal Agentic Studio: Pause"
      },
      {
        "command": "gru953-studio.resume",
        "title": "Universal Agentic Studio: Resume"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.39.0",
    "typescript": "^5.0.4"
  }
}
